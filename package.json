{
  "name": "enmo-os",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e:web": "pnpm --filter @enmo/web test:e2e",
    "services:up": "scripts/services.sh up",
    "services:down": "scripts/services.sh down",
    "db:migrate": "pnpm --filter @enmo/db db:migrate",
    "db:generate": "pnpm --filter @enmo/db db:generate",
    "db:seed": "pnpm --filter @enmo/db db:seed",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "globals": "17.12.0",
    "next": "16.3.6",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "turbo": "2.11.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
