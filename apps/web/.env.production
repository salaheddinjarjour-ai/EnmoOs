# Default for production builds (`next build`, `build:cf`, `deploy`), so a deploy can't silently
# ship a bundle pointing at localhost. The build environment and .env.local override it: CI, the
# Playwright servers and local development keep their own URLs.
#
# "same-origin": the browser calls /v1/* on the web app's own address and the Cloudflare Worker
# forwards it to API_ORIGIN (src/edge/api-proxy.ts), so sign-in works on any host (workers.dev
# included) without the app and the API sharing a parent domain.
NEXT_PUBLIC_API_URL=same-origin
