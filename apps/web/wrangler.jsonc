{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard (Workers Builds overrides it otherwise).
  "name": "enmoos",
  // Custom entry: the OpenNext handler plus a cron that keeps the Render API awake.
  "main": "worker.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      // OpenNext self-reference binding; must match "name".
      "binding": "WORKER_SELF_REFERENCE",
      "service": "enmoos",
    },
  ],
  // Serves on the Worker's workers.dev address. For app.enmo.marketing (needs the enmo.marketing
  // zone in this Cloudflare account), add:
  //   "routes": [{ "pattern": "app.enmo.marketing", "custom_domain": true }],
  "triggers": {
    // Render's free tier sleeps after 15 idle minutes.
    "crons": ["*/5 * * * *"],
  },
  // Set in the dashboard (Worker → Settings → Variables and Secrets), never here, so deploys keep
  // them (keep_vars):
  //   API_ORIGIN         the API's origin, e.g. https://enmo-api.onrender.com; /v1/* and /files/*
  //                      are forwarded to it (src/edge/api-proxy.ts) and the cron pings its /healthz
  //   EDGE_PROXY_SECRET  (secret) the same value as the API's EDGE_PROXY_SECRET
  //   KEEPALIVE_URL      optional; overrides API_ORIGIN + /healthz for the cron
  "keep_vars": true,
  "observability": {
    "enabled": true,
    // Invocation logs record every request URL, and /invite/<token> carries a one-time secret
    // (only its hash is stored). console output from the worker is still collected.
    "logs": { "invocation_logs": false },
  },
}
