# ENMO OS API — copy to apps/api/.env for local dev (loaded with node/tsx --env-file-if-exists=.env).
# Blank values count as unset. Local services: `scripts/services.sh up`.

# ── Server ──
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
# Public base URL of this API (OAuth callbacks, local file URLs). Default: http://localhost:$PORT
API_PUBLIC_URL=
# Proxies whose X-Forwarded-For entries to believe (rate limits, audit IPs): addresses, CIDRs or
# the names loopback, linklocal, uniquelocal, cloudflare. Production (Render behind Cloudflare):
# loopback,uniquelocal,cloudflare. A hop count also works but breaks when the proxy path changes.
# Avoid "true": it trusts the client-written left-most entry.
TRUST_PROXY=false
# Shared with the web Worker's EDGE_PROXY_SECRET (32+ characters) when the Worker proxies the API.
EDGE_PROXY_SECRET=
# Exact web origins (comma-separated) for CORS + the CSRF origin check; the first is the web app.
APP_ORIGINS=http://localhost:3000
# Production: .enmo.marketing. Blank = host-only cookie.
COOKIE_DOMAIN=
# Default: true when NODE_ENV=production.
COOKIE_SECURE=false
SESSION_TTL_DAYS=30

# ── Data ──
DATABASE_URL=postgresql://postgres@127.0.0.1:54329/enmo_dev
REDIS_URL=redis://127.0.0.1:63799
BULLMQ_PREFIX=enmo
# Seconds an idle worker blocks for jobs. Default: 20 when NODE_ENV=production, else 5.
BULLMQ_DRAIN_DELAY_SEC=5
# Run queue consumers inside the API process (`pnpm dev` sets this to true).
EMBEDDED_WORKER=false
SCHEDULERS_ENABLED=true

# ── LLM ──
# mock | anthropic. Default: anthropic when ANTHROPIC_API_KEY is set, else mock.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
# Deliberately not ANTHROPIC_BASE_URL.
ENMO_ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5
DAILY_TOKEN_CAP=2000000
AGENT_CONCURRENCY=4
MEDIA_CONCURRENCY=4
# Per-post actions the Manager may plan, from strategy,write,direct,adapt,qa. Must include write
# and qa; adapt needs direct. Phase 3 agents cover write,direct,qa (the default).
PIPELINE_ACTIONS=write,direct,qa
# Automatic Manager QA revisions per post (0-3) before it goes to humans with QA notes.
MAX_QA_REVISIONS=1
# MockLlm fault injection, e.g. COPYWRITER.write:invalid*2,VISUAL_DIRECTOR.review:weak*3
MOCK_LLM_FAULTS=
# MockLlm latency per call in ms (0-60000), so a local demo shows progress arriving live.
# Unset means 0 (the tests' setting).
MOCK_LLM_DELAY_MS=300
# Per-agent output_config.effort override: low | medium | high | xhigh | max. Blank keeps the
# defaults (high for Manager plan, Strategist, Analyst; medium for Manager intake, Copywriter,
# Visual Director direct; low for the rest).
AGENT_EFFORT_MANAGER=
AGENT_EFFORT_STRATEGIST=
AGENT_EFFORT_COPYWRITER=
AGENT_EFFORT_VISUAL_DIRECTOR=
AGENT_EFFORT_ADAPTER=
AGENT_EFFORT_ANALYST=
AGENT_EFFORT_PUBLISHER=

# ── Visuals ──
# mock (sharp-rendered branded placeholders) | higgsfield
VISUAL_PROVIDER=mock
# Higgsfield key as "<key id>:<key secret>", or the two halves below (not both). Required for
# VISUAL_PROVIDER=higgsfield.
HIGGSFIELD_CREDENTIALS=
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
HIGGSFIELD_BASE_URL=https://api.higgsfield.ai
# Model id for stills; required for VISUAL_PROVIDER=higgsfield (every post type has stills).
HIGGSFIELD_IMAGE_MODEL=
# Model id for video; optional (without it, reel and TikTok shots are stills too).
HIGGSFIELD_VIDEO_MODEL=
# Multi-scene video assembly; without it the first clip is used.
FFMPEG_PATH=
# Weak takes of one shot the Visual Director may regenerate (0-2) before it escalates.
MAX_VISUAL_REGENERATIONS=2
# First render poll after submit, in ms (10-10000); later polls back off to 10s.
RENDER_POLL_DELAY_MS=3000

# ── Storage ──
# local | r2. Production needs r2: Render's disk is ephemeral (a deploy wipes it) and Meta/TikTok
# fetch media by public URL, so NODE_ENV=production refuses local unless the flag below is set.
STORAGE_DRIVER=local
# Local driver directory, relative to the API's working directory.
STORAGE_LOCAL_DIR=.data/assets
# Only for a production host whose disk survives deploys. Default: false.
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false
# Local driver only: public base of /files/*. Default: $API_PUBLIC_URL/files
PUBLIC_ASSET_BASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Default: https://$R2_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ENDPOINT=
# The bucket's public domain. Default: https://assets.enmo.marketing
R2_PUBLIC_BASE_URL=

# ── Publishing ──
# dry-run | live. live publishes only on platforms whose app credentials are set, and only for
# clients with an account connected there; everything else stays a dry run
# (https://dryrun.enmo.marketing/... URLs). live with no platform credentials at all is refused.
PUBLISH_MODE=dry-run
# Where the OAuth callback sends the browser back to. Default: the first APP_ORIGINS entry.
APP_PUBLIC_URL=
# Meta app (Facebook Pages + Instagram): set both or neither.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
META_GRAPH_BASE_URL=https://graph.facebook.com
# Facebook Reels upload host.
META_RUPLOAD_BASE_URL=https://rupload.facebook.com
# Host of the OAuth consent dialog.
META_OAUTH_DIALOG_URL=https://www.facebook.com
# Must match the redirect URI registered with the Meta app exactly.
# Default: $API_PUBLIC_URL/v1/oauth/meta/callback
META_REDIRECT_URI=
# Seconds between checks of media the platform is still processing (1-300).
PUBLISH_POLL_INTERVAL_SEC=10
# Minutes a publish may wait on that processing before it fails (1-1440).
PUBLISH_POLL_MAX_MIN=10
# Publish attempts per job, the first included, before it fails for good (1-10).
PUBLISH_MAX_ATTEMPTS=3
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_API_BASE_URL=https://open.tiktokapis.com
# Unaudited TikTok apps can only post SELF_ONLY.
TIKTOK_APP_AUDITED=false

# ── Secrets and seed ──
# Required outside tests: 32 bytes as base64 (`openssl rand -base64 32`) or 64 hex chars.
TOKEN_ENC_KEY=
# First ADMIN, created on boot only while the users table is empty (password: 12+ characters).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
