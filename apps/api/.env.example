# ENMO OS API — copy to apps/api/.env for local dev (loaded with node/tsx --env-file-if-exists=.env).
# Blank values count as unset. Local services: `scripts/services.sh up`.

# ── Server ──
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
# Public base URL of this API (OAuth callbacks, local file URLs). Default: http://localhost:$PORT
API_PUBLIC_URL=
# Proxies whose X-Forwarded-For entries to believe (rate limits, audit IPs): addresses, CIDRs or
# the names loopback, linklocal, uniquelocal, cloudflare. Production (Render behind Cloudflare):
# loopback,uniquelocal,cloudflare. A hop count also works but breaks when the proxy path changes.
# Avoid "true": it trusts the client-written left-most entry.
TRUST_PROXY=false
# Exact web origins (comma-separated) for CORS + the CSRF origin check; the first is the web app.
APP_ORIGINS=http://localhost:3000
# Production: .enmo.marketing. Blank = host-only cookie.
COOKIE_DOMAIN=
# Default: true when NODE_ENV=production.
COOKIE_SECURE=false
SESSION_TTL_DAYS=30

# ── Data ──
DATABASE_URL=postgresql://postgres@127.0.0.1:54329/enmo_dev
REDIS_URL=redis://127.0.0.1:63799
BULLMQ_PREFIX=enmo
# Seconds an idle worker blocks for jobs (5 dev, 20 prod).
BULLMQ_DRAIN_DELAY_SEC=5
# Run queue consumers inside the API process (`pnpm dev` sets this to true).
EMBEDDED_WORKER=false
SCHEDULERS_ENABLED=true

# ── LLM ──
# mock | anthropic. Default: anthropic when ANTHROPIC_API_KEY is set, else mock.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
# Deliberately not ANTHROPIC_BASE_URL.
ENMO_ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5
DAILY_TOKEN_CAP=2000000
AGENT_CONCURRENCY=4
MEDIA_CONCURRENCY=4
# Per-post actions the Manager may plan: strategy,write,direct,adapt,qa
PIPELINE_ACTIONS=write,qa
# MockLlm fault injection, e.g. COPYWRITER.write:invalid*2,VISUAL_DIRECTOR.review:weak*3
MOCK_LLM_FAULTS=

# ── Visuals ──
# mock | higgsfield
VISUAL_PROVIDER=mock
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
HIGGSFIELD_BASE_URL=https://api.higgsfield.ai
HIGGSFIELD_IMAGE_MODEL=
HIGGSFIELD_VIDEO_MODEL=
# Multi-scene video assembly; without it the first clip is used.
FFMPEG_PATH=

# ── Storage ──
# local | r2 (production needs r2: Render's disk is ephemeral and Meta/TikTok need public URLs)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
# Default: $API_PUBLIC_URL/v1/files (local) or https://assets.enmo.marketing (r2)
PUBLIC_ASSET_BASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Default: https://$R2_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ENDPOINT=

# ── Publishing ──
# dry-run | live
PUBLISH_MODE=dry-run
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
META_GRAPH_BASE_URL=https://graph.facebook.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_API_BASE_URL=https://open.tiktokapis.com
# Unaudited TikTok apps can only post SELF_ONLY.
TIKTOK_APP_AUDITED=false

# ── Secrets and seed ──
# Required outside tests: 32 bytes as base64 (`openssl rand -base64 32`) or 64 hex chars.
TOKEN_ENC_KEY=
# First ADMIN, created on boot only while the users table is empty (password: 12+ characters).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
