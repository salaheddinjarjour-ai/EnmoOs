# Used by the Prisma CLI (prisma.config.ts) and `pnpm db:seed`.
# Local services: `scripts/services.sh up` then `scripts/services.sh env`.
DATABASE_URL=postgresql://postgres@127.0.0.1:54329/enmo_dev

# Optional seed inputs (src/seed.ts): the first ADMIN, created only while the users table is empty.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
# true → also create the demo client "Qahwa Co".
SEED_DEMO=false
